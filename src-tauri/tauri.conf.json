{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edge Ghosty",
  "version": "1.0.10",
  "identifier": "com.edgemochi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Edge Ghosty",
        "width": 900,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "dragDropEnabled": true,
        "visible": true
      },
      {
        "label": "utility-popup",
        "title": "Edge Ghosty",
        "width": 560,
        "height": 472,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "dragDropEnabled": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings-window",
        "title": "Configurações — Edge Ghosty",
        "width": 1040,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "updater-main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": {
      "bundleVCRuntime": true,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "startMenuFolder": "Edge Ghosty",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0NjY4MjRCRUNCQzJCOEEKUldTS0s3enNTNEptdEhZQkJMOWJXQ3Fockxib3J5N0hLQy95cmc2eG4zbU93dHNGVHc2YWhDdEYK",
      "endpoints": ["https://github.com/gusata/Ghosty/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
